{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译当前 C 文件 (gcc)",
            "type": "shell",
            "command": "C:/Program Files (x86)/Embarcadero/Dev-Cpp/TDM-GCC-64/bin/gcc.exe",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "编译并运行当前 C 文件",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "group": "test",
            "dependsOn": "编译当前 C 文件 (gcc)",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
